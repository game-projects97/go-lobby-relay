[Unit]
Description=Lobby relay Cloudflare Tunnel (player API and deploy SSH)
After=network-online.target lobby-relay.service
Wants=network-online.target
ConditionPathExists=!/var/lib/lobby-relay/traffic-stopped
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=cloudflared
Group=cloudflared
EnvironmentFile=/etc/lobby-relay/traffic.env
# Only this preflight runs as root to read/update protected traffic accounting.
ExecStartPre=+/opt/lobby-relay/ops/check-traffic-budget.sh --check-start
ExecStart=/opt/lobby-relay/ops/cloudflared tunnel --no-autoupdate run --token-file /etc/lobby-relay/tunnel-token
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/lobby-relay
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=256M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
