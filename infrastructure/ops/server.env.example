# Non-secret values written by setup-host.sh to /etc/lobby-relay/server.env (root:root 0644).
# HTTPS hostname for the player API, served by Caddy.
API_HOSTNAME=api.example.com
# Hostname returned to players in relay grants. May equal API_HOSTNAME: both point at this host.
RELAY_ADVERTISED_HOST=relay.example.com
RELAY_UDP_PORT=7777
