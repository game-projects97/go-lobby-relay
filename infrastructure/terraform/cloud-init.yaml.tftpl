#cloud-config
package_update: true
packages:
  - ufw
  - ca-certificates
  - curl
  - unattended-upgrades
users:
  - default
  - name: lobby-relay
    system: true
    shell: /usr/sbin/nologin
    lock_passwd: true
  - name: cloudflared
    system: true
    shell: /usr/sbin/nologin
    lock_passwd: true
write_files:
  - path: /etc/ssh/sshd_config.d/10-lobby-relay.conf
    permissions: '0644'
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
  - path: /etc/systemd/journald.conf.d/lobby-relay.conf
    permissions: '0644'
    content: |
      [Journal]
      SystemMaxUse=100M
      RuntimeMaxUse=32M
      MaxRetentionSec=7day
  - path: /usr/local/sbin/lobby-relay-memory-report
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu
      awk '/MemTotal:/ {t=$2} /MemAvailable:/ {a=$2} END {p=100*(t-a)/t; printf "memory_used_percent=%.1f available_kib=%d\n",p,a; if(p>=85) print "WARNING memory_used_percent >= 85"}' /proc/meminfo
  - path: /etc/systemd/system/lobby-relay-memory-report.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Record host memory pressure in bounded journal
      [Service]
      Type=oneshot
      User=nobody
      ExecStart=/usr/local/sbin/lobby-relay-memory-report
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
  - path: /etc/systemd/system/lobby-relay-memory-report.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Sample host memory every minute
      [Timer]
      OnBootSec=1min
      OnUnitActiveSec=1min
      [Install]
      WantedBy=timers.target
runcmd:
  - [install, -d, -m, '0755', /opt/lobby-relay/releases]
  - [install, -d, -m, '0711', /etc/lobby-relay]
  - [install, -d, -m, '0755', -o, root, -g, root, /var/lib/lobby-relay]
  - [sed, -i, 's/^IPV6=.*/IPV6=yes/', /etc/default/ufw]
  - [ufw, default, deny, incoming]
  - [ufw, default, allow, outgoing]
  - [ufw, allow, from, '${admin_ipv4_cidr}', to, any, port, '22', proto, tcp]
  - [ufw, allow, proto, udp, from, 0.0.0.0/0, to, any, port, '${relay_udp_port}']
  - [ufw, --force, enable]
  - [sshd, -t]
  - [systemctl, restart, ssh]
  - [systemctl, restart, systemd-journald]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, lobby-relay-memory-report.timer]
# CI installs versioned binaries, systemd units and 0600 runtime secrets separately.
# UFW allows loopback by default; only the relay UDP port is public. Player HTTP
# arrives through the Tunnel, and operator HTTP stays loopback-only.
